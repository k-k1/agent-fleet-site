---
// Starlight's header, plus the language and theme selects on narrow screens for pages without a sidebar.
// Below 50rem Starlight shows those selects only in the mobile menu, which is part of the sidebar; the splash landing
// page (/docs/, /docs/ja/) has none, so a phone had no way to switch language there. Pages with a sidebar are
// unchanged.
import Default from '@astrojs/starlight/components/Header.astro';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const { hasSidebar } = Astro.locals.starlightRoute;
---

{
  hasSidebar ? (
    <Default><slot /></Default>
  ) : (
    <div class="af-header">
      <Default><slot /></Default>
      <div class="af-narrow-selects print:hidden">
        <LanguageSelect />
        <ThemeSelect />
      </div>
    </div>
  )
}

<style>
  .af-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
  }
  .af-header > :global(:first-child) {
    flex: 1;
    min-width: 0;
  }
  .af-narrow-selects {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  @media (min-width: 50rem) {
    .af-narrow-selects {
      display: none;
    }
  }
  /* On a phone the two selects leave no room for the site name: the logo stays, the name is kept for screen readers
     only (the logo's alt is empty), and the hero below says it anyway. */
  @media (max-width: 49.99rem) {
    .af-header :global(.site-title span) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
